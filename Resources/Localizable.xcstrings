    "setup.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate your plan — Stickflow sorts it into tasks. For that it downloads two models: %@ GB, once. They work offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надиктуй план — Stickflow разложит его по задачам. Для этого скачаем две модели: %@ ГБ, один раз. Работают без интернета."
          }
        }
      }
    },
    "setup.later": {
      "extractionState": "manual",
      "localizations": {
